[Unit]
Description=SED stack (docker compose)
After=docker.service
Requires=docker.service

[Service]
# Тип oneshot: compose up -d завершается сразу, стек живет в Docker.
# Restart здесь НЕ нужен (oneshot + RemainAfterExit держит состояние).
Type=oneshot
RemainAfterExit=yes
# Корень развертывания на ВМ. Значение по умолчанию — /srv/sed.
# Путь настраивается: при установке в другой каталог (например /opt/sed)
# заменить WorkingDirectory ниже; файлы compose/.env должны лежать в нем.
WorkingDirectory=/srv/sed
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
