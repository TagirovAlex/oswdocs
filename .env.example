# СЭД — пример переменных окружения (Фаза 0, Задача 1).
# Скопируйте в .env и заполните реальными значениями (в git НЕ коммитить).
# Здесь ТОЛЬКО плейсхолдеры вида changeme/example.com. Реальных секретов/DN/URL нет.
# Полный каталог настроек — README п.3 (инфра — здесь, прикладные — в settings БД).

# --- Postgres / приложение ---
DATABASE_URL=postgresql://changeme:changeme@example.com:5432/sed
POSTGRES_DB=sed
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme

# --- Redis (брокер + кэш) ---
REDIS_URL=redis://example.com:6379/0

# --- Active Directory (ТОЛЬКО чтение через LDAPS bind, проверка memberOf) ---
AD_URL=ldaps://example.com:636
AD_BASE_DN=DC=example,DC=com
AD_READER_DN=CN=changeme,OU=changeme,DC=example,DC=com
AD_READER_SECRET=changeme
LDAP_CACHE_TTL=300

# --- 1С ЗУП (ТОЛЬКО чтение, мультибаза: предприятие -> база -> url+user+secret) ---
ONEC_BASES_JSON={"changeme": {"changeme": {"url": "https://example.com/changeme", "user": "changeme", "secret": "changeme"}}}

# --- AD write-заглушка: ВСЕГДА false (запись в AD запрещена, см. AGENTS.md п.4) ---
AD_WRITE_ENABLED=false

# --- TLS-сертификат (read-only mount в proxy, хост-каталог) ---
CERT_PATH=/srv/sed/certs
# Intranet-домен для proxy (nginx server_name через envsubst, дефолт-заглушка)
SERVER_NAME=sed.company.local

# --- SMTP Exchange (уведомления на mail из AD) ---
SMTP_HOST=example.com
SMTP_FROM=changeme@example.com
SMTP_USER=changeme
SMTP_PASSWORD=changeme
