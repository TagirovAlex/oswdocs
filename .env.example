# SED — primer peremennyh okruzheniya (Faza 0, Zadacha 1).
# Skopirujte v .env i zapolnite real'nymi znacheniyami (v git NE kommitit').
# Zdes' TOL'KO plejsholdery vida changeme/example.com. Real'nyh sekretov/DN/URL net.
# Polnyj katalog nastroek — README p.3 (infra — zdes', prikladnye — v settings BD).

# --- Postgres / prilozhenie ---
DATABASE_URL=postgresql://changeme:changeme@example.com:5432/sed
POSTGRES_DB=sed
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme

# --- Redis (broker + kesh) ---
REDIS_URL=redis://example.com:6379/0

# --- Active Directory (TOL'KO chtenie cherez LDAPS bind, proverka memberOf) ---
AD_URL=ldaps://example.com:636
AD_BASE_DN=DC=example,DC=com
AD_READER_DN=CN=changeme,OU=changeme,DC=example,DC=com
AD_READER_SECRET=changeme
LDAP_CACHE_TTL=300

# --- 1C ZUP (TOL'KO chtenie, multi-base: enterprise -> base -> url+user+secret) ---
ONEC_BASES_JSON={"changeme": {"changeme": {"url": "https://example.com/changeme", "user": "changeme", "secret": "changeme"}}}

# --- AD write-zaglushka: VSEGDA false (zapis' v AD zapreshchena, sm. AGENTS.md p.4) ---
AD_WRITE_ENABLED=false

# --- TLS-sertifikat (read-only mount v proxy, host-katalog) ---
CERT_PATH=/srv/sed/certs
# Intranet-domen dlya proxy (nginx server_name cherez envsubst, defolt-zaglushka)
SERVER_NAME=sed.company.local

# --- SMTP Exchange (uvedomleniya na mail iz AD) ---
SMTP_HOST=example.com
SMTP_FROM=changeme@example.com
SMTP_USER=changeme
SMTP_PASSWORD=changeme
